(security_headers) {
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }
}

(spa) {
  # Two API instances. Each is checked every few seconds; a failed one is skipped, and a request that
  # could not be delivered is tried on the other, so one instance can stop or restart without an outage.
  # Assistant replies stream token by token; pass each piece straight through.
  handle /api/company/assistant/chat {
    reverse_proxy api:3001 api2:3001 {
      flush_interval -1
      lb_policy least_conn
      lb_try_duration 8s
      lb_try_interval 250ms
      health_uri /api/health
      health_interval 5s
      health_timeout 3s
      fail_duration 10s
    }
  }
  handle /api/* {
    reverse_proxy api:3001 api2:3001 {
      lb_policy least_conn
      lb_try_duration 8s
      lb_try_interval 250ms
      health_uri /api/health
      health_interval 5s
      health_timeout 3s
      fail_duration 10s
    }
  }
  # If both instances are briefly away, the app gets a message it can show, not a blank error.
  handle_errors {
    @down expression `{err.status_code} in [502, 503, 504]`
    handle @down {
      header Content-Type application/json
      header Retry-After 5
      respond `{"error":"FindBox is busy for a moment. Please try again."}` {err.status_code}
    }
  }
  handle {
    root * {args[0]}
    @immutable path /assets/* /media/*
    header @immutable Cache-Control "public, max-age=604800"
    @fresh path /index.html /sw.js /manifest.webmanifest
    header @fresh Cache-Control "no-cache"
    # A missing release file must be a real 404, not the home page, or an old tab breaks instead of reloading.
    handle /assets/* {
      file_server
    }
    handle {
      try_files {path} /index.html
      file_server
    }
  }
}

# Families and the public website.
{$SITE_ADDRESS} {
  @www host www.findbox.africa
  redir @www https://findbox.africa{uri} permanent
  redir /how-it-works "/#how-it-works" 308
  encode zstd gzip
  import security_headers
  @company path /company /company/* /app /app/* /manage /manage/* /t /t/*
  header @company X-Robots-Tag "noindex, nofollow, noarchive"
  header @company Cache-Control "no-store"
  import spa /srv
}

# Company and developer workspace: its own build, never indexed, optionally limited to known networks.
{$OPS_SITE_ADDRESS} {
  encode zstd gzip
  import security_headers
  header X-Robots-Tag "noindex, nofollow, noarchive"
  header Cache-Control "no-store"
  @outside not remote_ip {$OPS_ALLOWED_IPS}
  respond @outside "This workspace is not available from your network." 403
  import spa /srv-ops
}

# Teachers and school administrators.
{$SCHOOL_SITE_ADDRESS} {
  encode zstd gzip
  import security_headers
  header X-Robots-Tag "noindex, nofollow, noarchive"
  redir / /school/sign-in 302
  import spa /srv
}
