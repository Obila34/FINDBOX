# Copy to .env. Keep credentials out of version control.
DATABASE_URL=postgres://findbox:replace-with-a-long-random-password@127.0.0.1:5432/findbox
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ORIGIN=http://localhost:5173
SITE_ADDRESS=localhost
PORT=3001
# Run NODE_ENV=production only with HTTPS APP_ORIGIN.
NODE_ENV=development
# Checkout remains unavailable until configured. Use test keys during acceptance testing.
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
MAIL_FROM=

# Enable server-connected frontend only on the private VPS/staging build.
VITE_SERVER_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded random 32-byte key; back it up separately from the database.
ENCRYPTION_KEY=
DB_POOL_SIZE=10

# Comma-separated user IDs authorised for the central support inbox (staff/manager only).
SUPPORT_ADMIN_IDS=

# Developer-only Daraja sandbox; does not enable customer checkout.
DARAJA_SANDBOX_CONSUMER_KEY=
DARAJA_SANDBOX_CONSUMER_SECRET=
DARAJA_SANDBOX_SHORTCODE=
DARAJA_SANDBOX_PASSKEY=

# Enable only after a successful SMTP delivery test.
COMPANY_EMAIL_CODES=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
